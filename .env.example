# Clave de desarrollo. No usar este valor en producción.
DJANGO_SECRET_KEY=dev-only-change-me

# El código usa False si esta variable no está definida.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Motor de la conexión por defecto.
# postgresql es el entorno local: Docker Compose publica la base en localhost.
# sqlite permite arrancar si Docker no está corriendo.
DJANGO_DB_ENGINE=postgresql

# PostgreSQL. Compose lee estas variables. Django, en el equipo, usa POSTGRES_HOST=localhost.
# El servicio backend del Compose pisa el host con el nombre postgres y el puerto interno 5432.
# Estos valores son placeholders, no credenciales reales.
POSTGRES_DB=out_of_context
POSTGRES_USER=out_of_context
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
