# URL pública del backend. Expo incluye EXPO_PUBLIC_* en el bundle.
# No pongas aquí claves del servidor ni contraseñas de la base de datos.
#
# Emulador Android: http://10.0.2.2:8000
# Dispositivo físico en la misma red: http://<IP-LAN-del-equipo>:8000
# Navegador en la misma máquina: http://127.0.0.1:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
